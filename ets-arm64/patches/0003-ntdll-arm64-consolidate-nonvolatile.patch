From: ETS-ARM64 project
Subject: [PATCH] ntdll: Load non-volatile registers from the target context before calling ARM64 consolidate callbacks.

MSVC ARM64 C++ catch funclets use the parent frame non-volatile registers (x19-x28, d8-d15).
Run the STATUS_UNWIND_CONSOLIDATE callback with these registers loaded from the unwound context
and store them back afterwards, so the continuation sees updates made by the catch block.
---
diff -ru a/dlls/ntdll/signal_arm64.c b/dlls/ntdll/signal_arm64.c
--- a/dlls/ntdll/signal_arm64.c	2026-11-13 23:02:23.303102584 +0100
+++ b/dlls/ntdll/signal_arm64.c	2026-11-13 23:02:23.314312080 +0100
@@ -407,7 +407,36 @@
 __ASM_GLOBAL_FUNC( invoke_callback,
                    ".seh_context\n\t"
                    ".seh_endprologue\n\t"
+                   /* the callback (e.g. a C++ catch block funclet) runs with the
+                    * non-volatile registers of the target frame */
+                   "ldp x19, x20, [sp, #0xa0]\n\t" /* context->X19,X20 */
+                   "ldp x21, x22, [sp, #0xb0]\n\t" /* context->X21,X22 */
+                   "ldp x23, x24, [sp, #0xc0]\n\t" /* context->X23,X24 */
+                   "ldp x25, x26, [sp, #0xd0]\n\t" /* context->X25,X26 */
+                   "ldp x27, x28, [sp, #0xe0]\n\t" /* context->X27,X28 */
+                   "ldr d8,  [sp, #0x190]\n\t"     /* context->V[8] */
+                   "ldr d9,  [sp, #0x1a0]\n\t"
+                   "ldr d10, [sp, #0x1b0]\n\t"
+                   "ldr d11, [sp, #0x1c0]\n\t"
+                   "ldr d12, [sp, #0x1d0]\n\t"
+                   "ldr d13, [sp, #0x1e0]\n\t"
+                   "ldr d14, [sp, #0x1f0]\n\t"
+                   "ldr d15, [sp, #0x200]\n\t"
                    "blr x1\n\t"
+                   /* and may modify them for the continuation */
+                   "stp x19, x20, [sp, #0xa0]\n\t"
+                   "stp x21, x22, [sp, #0xb0]\n\t"
+                   "stp x23, x24, [sp, #0xc0]\n\t"
+                   "stp x25, x26, [sp, #0xd0]\n\t"
+                   "stp x27, x28, [sp, #0xe0]\n\t"
+                   "str d8,  [sp, #0x190]\n\t"
+                   "str d9,  [sp, #0x1a0]\n\t"
+                   "str d10, [sp, #0x1b0]\n\t"
+                   "str d11, [sp, #0x1c0]\n\t"
+                   "str d12, [sp, #0x1d0]\n\t"
+                   "str d13, [sp, #0x1e0]\n\t"
+                   "str d14, [sp, #0x1f0]\n\t"
+                   "str d15, [sp, #0x200]\n\t"
                    "str x0, [sp, #0x108]\n\t" /* context->Pc */
                    "mov x0, sp\n\t"
                    "mov w1, #0\n\t"
